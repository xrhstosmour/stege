<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- Hardened runtime blocks Calendar TCC access outright without this,
	     with no prompt and no entry in System Settings, rather than merely
	     denying it: `NSCalendarsFullAccessUsageDescription` alone is not
	     enough once hardened runtime is enabled. -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
</dict>
</plist>
