<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required by TCC. Reading paired devices through IOBluetooth counts as
	     privacy-sensitive access on macOS 26, and without this key the process
	     is terminated the moment the Bluetooth widget reads anything. -->
	<!-- Icons in an asset catalog are only found through this key. Without it
	     the compiled AppIcon sits unused in Assets.car and macOS falls back to
	     the generic application icon. -->
	<!-- Both keys. `CFBundleIconName` points at the asset catalog, which is
	     what modern macOS prefers, and `CFBundleIconFile` points at a real
	     .icns. The catalog alone yielded the system placeholder icon here, so
	     the .icns is what actually gets drawn. -->
	<!-- Stege is a menu bar replacement, so it has no window to switch to and
	     nothing to click in the Dock. Without this it takes a Dock tile and an
	     app menu of its own, both of which are dead weight, and the tile sits
	     next to the apps whose menus the bar is showing. -->
	<key>LSUIElement</key>
	<true/>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Stege shows which Bluetooth devices are connected and their battery levels in the menu bar.</string>
	<!-- `INFOPLIST_KEY_*` build settings merge into this file at build time, so
	     this key was already reaching the built app, but only from a value no
	     bundle inspection of the shipped Info.plist itself could confirm. Kept
	     here instead, next to the other TCC strings, so it is never in doubt. -->
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Stege shows today's events in the clock popup and counts down to the next one.</string>
</dict>
</plist>
